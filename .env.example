# Токен бота Telegram от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID администраторов (через запятую) — имеют доступ к рассылке, поиску и статистике
# Пример: ADMIN_IDS=2035205294,123456789
ADMIN_IDS=2035205294

# Кулдаун (кд) между запросами расписания в секундах (300 сек = 5 минут)
SCHEDULE_COOLDOWN=300

